# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/imzala
# API port
PORT=3001
# Exact frontend origin (CORS + CSRF origin check)
FRONTEND_URL=http://localhost:3000
# Long random string used to sign JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
TOKEN_SECRET=change-me
# JWT lifetime
JWT_EXPIRE=7d
